{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
  ],
  "packageRules": [
    {
      "description": "Review networking upgrades together with the Hermit runtime and vendored socket/connector patches.",
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "tokio",
        "tokio-util",
        "socket2",
        "hyper-util",
        "reqwest",
        "https://github.com/hermit-os/tokio",
      ],
      "groupName": "Hermit networking dependencies",
      "groupSlug": "hermit-networking",
      "separateMajorMinor": false,
    },
    {
      "description": "Keep Sigstore crates on the same Git revision to avoid incompatible duplicate types.",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["https://github.com/sigstore/sigstore-rust"],
      "groupName": "sigstore",
      "groupSlug": "sigstore",
    },
    {
      "description": "Update crypto dependencies together because they share signature, digest, DER, PKCS#8, and RNG traits.",
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "cms",
        "der",
        "ed25519-dalek",
        "hmac",
        "ml-dsa",
        "p256",
        "p384",
        "rand",
        "rsa",
        "rustls-rustcrypto",
        "sha2",
        "x509-cert",
      ],
      "groupName": "crypto dependencies",
      "groupSlug": "crypto",
      "separateMajorMinor": false,
    },
  ],
}
